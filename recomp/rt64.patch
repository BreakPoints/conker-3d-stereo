diff --git a/src/render/rt64_leiasr_abi.h b/src/render/rt64_leiasr_abi.h
new file mode 100644
index 0000000..ab66c34
--- /dev/null
+++ b/src/render/rt64_leiasr_abi.h
@@ -0,0 +1,43 @@
+//
+// RT64
+//
+
+#pragma once
+
+#include <cstdint>
+
+// Conker: the C ABI between RT64 and conker_leia_sr.dll, the optional loader that binds
+// Leia's SR (Simulated Reality) SDK. The DLL is built separately (host/leia) against the
+// proprietary SDK and loaded at run time, so RT64 and the game executable carry no SR
+// imports at all: without the DLL, or without the SR Platform it delay-loads, the Leia SR
+// mode presents the plain side-by-side pair.
+//
+// The DLL exports one function, conker_leia_sr_get_api(version), returning this struct for
+// the version it implements and null otherwise. Both sides must agree on the layout; bump the
+// version on any change.
+
+#define CONKER_LEIA_SR_ABI_VERSION 1
+#define CONKER_LEIA_SR_GET_API "conker_leia_sr_get_api"
+
+struct conker_leia_sr_api_v1 {
+    uint32_t version;
+    uint32_t pad;
+
+    // device: ID3D12Device*, queue: the ID3D12CommandQueue the weave is submitted on,
+    // window: the HWND being presented to (the weaver reads its position on the panel).
+    // False when the SR runtime, service or display isn't available.
+    bool (*create)(void *device, void *queue, void *window, void **outHandle);
+
+    // Records and submits the weave on its own command list, on the queue given to create:
+    // FIFO after whatever the caller submitted before, before whatever it submits after.
+    // input: ID3D12Resource* of the full side-by-side pair (2W x H, L left, R right), in a
+    // pixel-shader-readable state. output: ID3D12Resource* (W x H, render-target state) the
+    // woven image is written to. Neither resource's state is changed. outputFormat is the
+    // output's DXGI_FORMAT. False when the weave failed (the caller stops using the handle).
+    bool (*weave)(void *handle, void *input, void *output, uint32_t width, uint32_t height, uint32_t outputFormat);
+
+    // Waits for this module's submissions, then releases the weaver and the SR context.
+    void (*destroy)(void *handle);
+};
+
+typedef const void *(*conker_leia_sr_get_api_fn)(uint32_t version);
diff --git a/src/render/rt64_leiasr_weaver.cpp b/src/render/rt64_leiasr_weaver.cpp
new file mode 100644
index 0000000..cfa873b
--- /dev/null
+++ b/src/render/rt64_leiasr_weaver.cpp
@@ -0,0 +1,163 @@
+//
+// RT64
+//
+
+#include "rt64_leiasr_weaver.h"
+
+#include <cstdio>
+#include <cstdlib>
+
+#if defined(_WIN32)
+
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+
+#include <string>
+
+#include "rt64_leiasr_abi.h"
+
+namespace RT64 {
+    struct LeiaSRWeaver::State {
+        HMODULE module = nullptr;
+        const conker_leia_sr_api_v1 *api = nullptr;
+        void *handle = nullptr;
+        // Latched after a failure: the module, the runtime or the display isn't usable, and
+        // probing again every frame would only repeat the failure.
+        bool unavailable = false;
+    };
+
+    static void leiaLatch(LeiaSRWeaver::State &state, const char *why) {
+        std::fprintf(stderr, "[RT64] LeiaSR: %s. Presenting side-by-side instead.\n", why);
+        state.unavailable = true;
+    }
+
+    // conker_leia_sr.dll is looked up next to the executable only, never on the search path.
+    static HMODULE loadLeiaModule() {
+        wchar_t path[MAX_PATH];
+        const DWORD length = GetModuleFileNameW(nullptr, path, MAX_PATH);
+        if ((length == 0) || (length >= MAX_PATH)) {
+            return nullptr;
+        }
+
+        std::wstring modulePath(path, length);
+        const size_t separator = modulePath.find_last_of(L"\\/");
+        modulePath = (separator == std::wstring::npos) ? std::wstring() : modulePath.substr(0, separator + 1);
+        modulePath += L"conker_leia_sr.dll";
+
+        // The module's own folder is searched for its dependencies (SR-lib's static code
+        // only; the SR runtime DLLs are delay-loaded from the SR Platform's install).
+        return LoadLibraryExW(modulePath.c_str(), nullptr, LOAD_WITH_ALTERED_SEARCH_PATH);
+    }
+
+    LeiaSRWeaver::LeiaSRWeaver() : state(std::make_unique<State>()) { }
+
+    LeiaSRWeaver::~LeiaSRWeaver() {
+        shutdown();
+        if (state->module != nullptr) {
+            FreeLibrary(state->module);
+            state->module = nullptr;
+            state->api = nullptr;
+        }
+    }
+
+    bool LeiaSRWeaver::initialize(void *d3d12Device, void *d3d12Queue, void *window) {
+        if (state->handle != nullptr) {
+            return true;
+        }
+
+        if (state->unavailable) {
+            return false;
+        }
+
+        if ((d3d12Device == nullptr) || (d3d12Queue == nullptr) || (window == nullptr)) {
+            leiaLatch(*state, "no D3D12 device, queue or window to weave with");
+            return false;
+        }
+
+        if (state->api == nullptr) {
+            state->module = loadLeiaModule();
+            if (state->module == nullptr) {
+                leiaLatch(*state, "conker_leia_sr.dll isn't next to the executable");
+                return false;
+            }
+
+            const conker_leia_sr_get_api_fn getApi = reinterpret_cast<conker_leia_sr_get_api_fn>(reinterpret_cast<void *>(GetProcAddress(state->module, CONKER_LEIA_SR_GET_API)));
+            state->api = (getApi != nullptr) ? static_cast<const conker_leia_sr_api_v1 *>(getApi(CONKER_LEIA_SR_ABI_VERSION)) : nullptr;
+            if (state->api == nullptr) {
+                FreeLibrary(state->module);
+                state->module = nullptr;
+                leiaLatch(*state, "conker_leia_sr.dll isn't a version this build knows");
+                return false;
+            }
+        }
+
+        void *handle = nullptr;
+        if (!state->api->create(d3d12Device, d3d12Queue, window, &handle) || (handle == nullptr)) {
+            leiaLatch(*state, "the SR runtime, service or display isn't available");
+            return false;
+        }
+
+        state->handle = handle;
+        std::fprintf(stderr, "[RT64] LeiaSR: weaver ready.\n");
+        return true;
+    }
+
+    void LeiaSRWeaver::shutdown() {
+        if ((state->handle != nullptr) && (state->api != nullptr)) {
+            state->api->destroy(state->handle);
+        }
+
+        state->handle = nullptr;
+    }
+
+    bool LeiaSRWeaver::isAvailable() const {
+        return state->handle != nullptr;
+    }
+
+    bool LeiaSRWeaver::weave(void *input, void *output, uint32_t width, uint32_t height, uint32_t outputFormat) {
+        if ((state->handle == nullptr) || (state->api == nullptr)) {
+            return false;
+        }
+
+        if (!state->api->weave(state->handle, input, output, width, height, outputFormat)) {
+            // A failed weave means the runtime is unusable for this device: tear the weaver
+            // down and latch it off, so later frames present the fallback instead of retrying.
+            shutdown();
+            leiaLatch(*state, "the weave failed");
+            return false;
+        }
+
+        return true;
+    }
+};
+
+#else
+
+namespace RT64 {
+    struct LeiaSRWeaver::State { };
+
+    LeiaSRWeaver::LeiaSRWeaver() : state(std::make_unique<State>()) { }
+
+    LeiaSRWeaver::~LeiaSRWeaver() { }
+
+    bool LeiaSRWeaver::initialize(void *, void *, void *) {
+        return false;
+    }
+
+    void LeiaSRWeaver::shutdown() { }
+
+    bool LeiaSRWeaver::isAvailable() const {
+        return false;
+    }
+
+    bool LeiaSRWeaver::weave(void *, void *, uint32_t, uint32_t, uint32_t) {
+        return false;
+    }
+};
+
+#endif
diff --git a/src/render/rt64_leiasr_weaver.h b/src/render/rt64_leiasr_weaver.h
new file mode 100644
index 0000000..98a71d9
--- /dev/null
+++ b/src/render/rt64_leiasr_weaver.h
@@ -0,0 +1,39 @@
+//
+// RT64
+//
+
+#pragma once
+
+#include <cstdint>
+#include <memory>
+
+namespace RT64 {
+    // Conker: hands RT64's side-by-side intermediate to a Leia SR (Simulated Reality)
+    // display's weaver, through conker_leia_sr.dll (see rt64_leiasr_abi.h). The module is
+    // loaded and the weaver created once, lazily, from the present thread; a failure at any
+    // step is latched (one log line, no retry every frame) and the caller presents the plain
+    // side-by-side pair. Windows only; a no-op elsewhere.
+    //
+    // The interface takes void* so this header stays free of the D3D12 types.
+    struct LeiaSRWeaver {
+        struct State;
+        std::unique_ptr<State> state;
+
+        LeiaSRWeaver();
+        ~LeiaSRWeaver();
+
+        // device: ID3D12Device*, queue: the ID3D12CommandQueue the weave is submitted on,
+        // window: HWND. False when the DLL, the SR runtime, the SR service or an SR display
+        // isn't available, now or in an earlier attempt.
+        bool initialize(void *d3d12Device, void *d3d12Queue, void *window);
+        void shutdown();
+        bool isAvailable() const;
+
+        // Submits the weave of input (ID3D12Resource*, the full 2W x H pair, pixel-shader
+        // readable) into output (ID3D12Resource*, W x H, render target) on the queue given
+        // to initialize: after everything submitted to it before, and before everything
+        // submitted after. False when the runtime failed; the weaver is then torn down and
+        // latched off, and the caller presents its side-by-side fallback.
+        bool weave(void *input, void *output, uint32_t width, uint32_t height, uint32_t outputFormat);
+    };
+};
