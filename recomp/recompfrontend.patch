+        case ultramodern::renderer::StereoMode::CrossEye:
+            return RT64::UserConfiguration::StereoMode::CrossEye;
+        case ultramodern::renderer::StereoMode::Interlaced:
+            return RT64::UserConfiguration::StereoMode::Interlaced;
+        case ultramodern::renderer::StereoMode::InterlacedReversed:
+            return RT64::UserConfiguration::StereoMode::InterlacedReversed;
+        case ultramodern::renderer::StereoMode::TopAndBottom:
+            return RT64::UserConfiguration::StereoMode::TopAndBottom;
+        case ultramodern::renderer::StereoMode::LeiaSR:
+            return RT64::UserConfiguration::StereoMode::LeiaSR;
+        default:
+        case ultramodern::renderer::StereoMode::Off:
+        case ultramodern::renderer::StereoMode::OptionCount:
+            return RT64::UserConfiguration::StereoMode::Off;
+    }
